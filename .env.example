# SEO Auditor Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Anthropic API
# =============================================================================
# Get your API key from https://console.anthropic.com/
SEO_AUDITOR_ANTHROPIC_API_KEY=sk-ant-api03-...

# =============================================================================
# OPTIONAL: Claude Settings
# =============================================================================
# Model to use (default: claude-sonnet-4-20250514)
# SEO_AUDITOR_CLAUDE_MODEL=claude-sonnet-4-20250514

# Maximum tokens per response (default: 8192)
# SEO_AUDITOR_CLAUDE_MAX_TOKENS=8192

# Rate limiting (adjust based on your API tier)
# SEO_AUDITOR_CLAUDE_REQUESTS_PER_MINUTE=50
# SEO_AUDITOR_CLAUDE_TOKENS_PER_MINUTE=80000

# =============================================================================
# OPTIONAL: Google Search Console
# =============================================================================
# Path to Google Cloud service account JSON credentials
# SEO_AUDITOR_GSC_CREDENTIALS_PATH=./credentials.json

# Use OAuth instead of service account (default: false)
# SEO_AUDITOR_GSC_USE_OAUTH=false

# Path to OAuth credentials if using OAuth
# SEO_AUDITOR_GSC_OAUTH_CREDENTIALS_PATH=./oauth_credentials.json

# Days of GSC data to fetch (default: 90, max: 365)
# SEO_AUDITOR_GSC_DAYS_BACK=90

# Maximum rows to fetch from GSC (default: 25000)
# SEO_AUDITOR_GSC_ROW_LIMIT=25000

# =============================================================================
# OPTIONAL: Screaming Frog
# =============================================================================
# Path to Screaming Frog executable
# macOS default:
# SEO_AUDITOR_SF_EXECUTABLE_PATH=/Applications/Screaming Frog SEO Spider.app/Contents/MacOS/ScreamingFrogSEOSpiderLauncher
# Windows default:
# SEO_AUDITOR_SF_EXECUTABLE_PATH=C:\Program Files (x86)\Screaming Frog SEO Spider\ScreamingFrogSEOSpiderCli.exe
# Linux default:
# SEO_AUDITOR_SF_EXECUTABLE_PATH=/usr/bin/screamingfrogseospider

# Memory allocation for Screaming Frog (default: 4g)
# SEO_AUDITOR_SF_MEMORY_ALLOCATION=4g

# Maximum crawl depth (default: 10)
# SEO_AUDITOR_SF_MAX_CRAWL_DEPTH=10

# Maximum URLs to crawl (default: 50000)
# SEO_AUDITOR_SF_MAX_URLS=50000

# Crawl timeout in minutes (default: 120)
# SEO_AUDITOR_SF_CRAWL_TIMEOUT_MINUTES=120

# Respect robots.txt (default: true)
# SEO_AUDITOR_SF_RESPECT_ROBOTS=true

# Enable JavaScript rendering (default: false)
# SEO_AUDITOR_SF_RENDER_JAVASCRIPT=false

# User agent (default: Googlebot)
# SEO_AUDITOR_SF_USER_AGENT=Googlebot

# =============================================================================
# OPTIONAL: Output Settings
# =============================================================================
# Directory for generated reports (default: ./reports)
# SEO_AUDITOR_OUTPUT_DIR=./reports

# Directory for crawl exports (default: ./crawl_exports)
# SEO_AUDITOR_CRAWL_EXPORT_DIR=./crawl_exports

# =============================================================================
# OPTIONAL: Logging
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# SEO_AUDITOR_LOG_LEVEL=INFO

# Log format: json, console (default: console)
# SEO_AUDITOR_LOG_FORMAT=console

# Log file path (optional, logs to stdout by default)
# SEO_AUDITOR_LOG_FILE=./seo_auditor.log

# =============================================================================
# OPTIONAL: Analysis Settings
# =============================================================================
# Maximum URLs per analysis chunk (default: 500)
# SEO_AUDITOR_MAX_URLS_PER_CHUNK=500

# Maximum concurrent analysis passes (default: 3)
# SEO_AUDITOR_MAX_CONCURRENT_ANALYSES=3
